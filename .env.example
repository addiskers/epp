GEMINI_API_KEY=
# Must be a valid Gemini Live model id for your account + installed SDK.
MODEL=gemini-3.1-flash-live-preview

# ---- The helpline ----
EPP_COMPANY_NAME=EPP Composites
EPP_HELPLINE_NAME=EPP Composites Support Helpline
# Ticket numbers look like EPP-2026-000001 (letters/digits only; the year and sequence are added).
EPP_TICKET_PREFIX=EPP
# Languages the agent may take a call in (ISO codes, comma-separated). Remove any that fail
# the live-call check in DEPLOY.md rather than deleting them from languages.py.
EPP_ENABLED_LANGUAGES=en,hi,gu,mr,bn,ta,te,kn,ml,pa,or,as

# ---- Post-call analysis (summary, sentiment, classification refine / auto-create) ----
EPP_ANALYSIS_ENABLED=true
# A Gemini TEXT model (not a Live one). Verify the id against your account before go-live.
EPP_ANALYSIS_MODEL=gemini-3.6-flash

# ---- Call script ----
# What the agent says is the intake agent's TEMPLATE stored in the database and edited on
# the Agent page. The greeting, the language rule, the per-caller-type questions and the
# confirmation line all live there.

# ---- Voice ----
# Voice language bias (BCP-47), fixed per session. LEAVE BLANK: the native-audio model then
# auto-detects and follows the caller across all twelve languages. Setting en-IN pins an
# Indian-English accent but biases recognition and replies toward English/Hindi (seen live:
# Gujarati callers answered in Hindi). Only set it for a deliberate A/B on the test box.
EO_SPEECH_LANGUAGE_CODE=
# Expressiveness (native-audio models only). Try it on the TEST box first.
EO_AFFECTIVE_DIALOG=false
# Voice: Aoede (default, warm female). Others to A/B: Kore, Leda, Zephyr — no code change.
# EO_VOICE_NAME=Aoede

# ---- Plivo (the helpline number) ----
# From your Plivo console. Point the number's Answer URL at PUBLIC_URL/plivo/answer (GET).
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# The helpline number you own (E.164); also the caller ID for the Agent page's "Call me" test.
PLIVO_FROM_NUMBER=
# Public https URL Plivo can reach for the /plivo/answer webhook (e.g. https://helpline.example.com).
PUBLIC_URL=

# ---- Call behaviour ----
# The voice-engine knobs below keep their EO_ prefix (they predate this product); their
# meaning is unchanged. Safety cap: hang up any call that runs longer than this many seconds.
CALL_MAX_SECONDS=900
# Gentle pause (seconds) AFTER the goodbye audio has fully drained, before hanging up.
CALL_HANGUP_GRACE_SECONDS=0.5
# After the agent says goodbye (end_call), how long to keep listening in case the caller
# wants to continue.
CALL_END_GRACE_SECONDS=1
# Never cut the caller off mid-sentence: inbound audio is watched in real time (a VAD energy gate).
EO_VAD_RMS_THRESHOLD=500
EO_HANGUP_ABORT_WINDOW_SECONDS=1.2
EO_HANGUP_ABORT_MAX=1
EO_HOLD_GRACE_SECONDS=30             # keep the line open this long after "hold on / one minute"
# Quiet window after a ticket / status lookup before auto-hangup. Callers write the number down.
EO_POST_RSVP_IDLE_SECONDS=20
# Call recording: mix caller+agent into one mono 8kHz WAV per call (DATA_DIR/recordings/<call_sid>.wav),
# played back from the ticket. ~16 KB/s (~9 MB per 10-min call). Set false to disable.
EO_RECORD_CALLS=true
EO_RECORD_MAX_SECONDS=900
# ---- Reply latency (Gemini server VAD — tune on prod, watch the "TURN LATENCY" log lines) ----
EO_VAD_SILENCE_MS=550
EO_VAD_PREFIX_MS=250
EO_VAD_START_SENSITIVITY=LOW         # LOW = anti-echo on phone lines
EO_VAD_END_SENSITIVITY=HIGH          # HIGH = snappy end-of-turn
# ---- Barge-in / mid-sentence silence guards ----
EO_INTERRUPT_CONFIRM_WINDOW_S=0.8
EO_INTERRUPT_MIN_VOICED_MS=120
EO_PHANTOM_RESUME_DELAY_S=1.2
EO_PHANTOM_RESUME_MAX=2
EO_REPEAT_GUARD_FLUSH=false
EO_SUPPRESS_TURN_MAX_S=4
EO_HELLO_STORM_COUNT=3
EO_HELLO_STORM_WINDOW_S=15
EO_HELLO_STORM_MAX=2
EO_HELLO_STORM_COOLDOWN_S=30
EO_FAREWELL_WAIT_SECONDS=4
EO_AUDIO_INPUT_QUEUE_FRAMES=150
# ---- Silence check ("are you still there?") ----
EO_SILENCE_CHECK=true
EO_SILENCE_PROMPT_SECONDS=8          # mutual silence before the agent asks "are you still there?"
EO_SILENCE_HANGUP_SECONDS=10
EO_SILENCE_NUDGE_MAX=2
EO_SILENCE_NUDGE_COOLDOWN_S=15
EO_UNANSWERED_REPLY_SECONDS=2.5
EO_DEAF_RESCUE_SECONDS=6
EO_GREETING_NUDGE_SECONDS=4
# ---- Noise squelch (background voices/noise) — START DISABLED ----
EO_NOISE_GATE=false
EO_NOISE_GATE_RMS=250
EO_NOISE_GATE_HANGOVER_S=0.6

# ---- Outbound campaigns ----
# The dial loop for intake rounds, ticket follow-ups and announcements (Campaigns page).
# The Scheduler page's ON/OFF switch overrides this at runtime.
EPP_CAMPAIGN_RUNNER_ENABLED=true
# Campaigns allowed scheduled/live at once.
EPP_MAX_ACTIVE_CAMPAIGNS=6
# Pacing: new dials started per 30 s tick, and calls in flight per campaign. Campaign calls
# ALSO share MAX_LIVE_CALLS with the inbound helpline, so a campaign can never starve it.
EPP_CAMPAIGN_MAX_PER_TICK=2
EPP_CAMPAIGN_MAX_CONCURRENT=5
EPP_CAMPAIGN_POLL_INTERVAL=30
# Ring window before an unanswered dial counts as no-answer and is retried.
EPP_CAMPAIGN_NOANSWER_SECONDS=90
# Default calling hours (IST) for a campaign; each campaign sets its own at creation.
EPP_CALL_WINDOW_START=09:00
EPP_CALL_WINDOW_END=21:00
# Simultaneous live calls, inbound + campaign together. Each costs a Gemini session.
MAX_LIVE_CALLS=10

# ---- Admin (the React /admin app) ----
# First admin user, seeded ONLY if the users table is empty. Change these before first boot,
# then change the password again from the Profile page after first login.
EPP_ADMIN_USER=admin
EPP_ADMIN_PASS=change-me-now
# Signing key for login tokens (any long random string). Sessions last EPP_SESSION_TTL seconds (12h).
EPP_SESSION_SECRET=
# EPP_SESSION_TTL=43200
# Login throttle: this many failures in a row locks a username for this long.
# EPP_LOGIN_MAX_FAILURES=5
# EPP_LOGIN_LOCK_SECONDS=900
# Admin pages hidden from the client's admins. Only the STARTING list: once the super admin
# saves the tabs on the Super admin page, that choice wins. Keys: campaigns, contacts,
# scheduler, routing, agents, call-logs, users, audit, subscription. Blank = show everything.
EPP_HIDDEN_PAGES=campaigns,contacts,scheduler

# ---- Subscription (the Subscription page) ----
# What the client bought. Minutes are counted per phone call, rounded up to the next minute,
# for calls inside the period (IST dates, inclusive). Amount used = minutes × the rate.
EPP_PLAN_NAME=
EPP_PLAN_MINUTES=
EPP_PLAN_START=
EPP_PLAN_END=
EPP_LICENCE_VALID_TILL=
EPP_RATE_INR_PER_MIN=
# The service provider's logins (comma-separated usernames). They get the Super admin page
# (which tabs the client sees, clearing test data before go-live) and can edit the plan.
# Use your OWN admin account here, never the one you hand to the client. Blank = nobody.
EPP_SUPERADMIN_USERS=

# ---- Storage ----
# SQLite (epp.db), JSON call records (calls/<id>.json) and recordings (recordings/*.wav) live here.
DATA_DIR=

# ---- Gemini cost rates (USD per 1,000,000 tokens, paid tier) — admin-only reporting ----
RATE_GEMINI_TEXT_IN=0.75
RATE_GEMINI_AUDIO_IN=3.00
RATE_GEMINI_IMGVID_IN=1.00
RATE_GEMINI_TEXT_OUT=4.50
RATE_GEMINI_AUDIO_OUT=12.00
